<UserControl x:Class="Wu.CommTool.Modules.ModbusTcp.Views.ModbusTcpSlaveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="Wu.CommTool.Core"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:local="clr-namespace:Wu.CommTool.Modules.ModbusTcp.Views"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:models="clr-namespace:Wu.CommTool.Modules.ModbusTcp.Models"
             xmlns:wu="https://github.com/Monika1313/Wu"
             d:DesignHeight="450"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <Grid>
        <md:DrawerHost IsLeftDrawerOpen="{Binding DrawerState.LeftDrawer}" IsRightDrawerOpen="{Binding DrawerState.RightDrawer}">
            <md:DrawerHost.LeftDrawerContent>
                <Border DockPanel.Dock="Top" Style="{StaticResource FormBorder}">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Margin="5"
                                   HorizontalAlignment="Center"
                                   FontSize="24"
                                   Text="从站配置" />

                        <TextBox hc:TitleElement.Title="监听IP:"
                                 hc:TitleElement.TitleWidth="100"
                                 IsEnabled="{Binding MtcpSlave.IsRunning, Converter={wu:ReverseBool}}"
                                 Style="{StaticResource FormTextBox}"
                                 Text="{Binding MtcpSlave.ServerIp}" />

                        <TextBox hc:TitleElement.Title="监听端口:"
                                 hc:TitleElement.TitleWidth="100"
                                 IsEnabled="{Binding MtcpSlave.IsRunning, Converter={wu:ReverseBool}}"
                                 Style="{StaticResource FormTextBox}"
                                 Text="{Binding MtcpSlave.ServerPort}" />

                        <TextBox hc:Poptip.Content="设置为0时应答任意UnitId"
                                 hc:TitleElement.Title="从站ID(UnitId):"
                                 hc:TitleElement.TitleWidth="100"
                                 IsEnabled="{Binding MtcpSlave.IsRunning, Converter={wu:ReverseBool}}"
                                 Style="{StaticResource FormTextBox}"
                                 Text="{Binding MtcpSlave.SlaveId}" />

                        <TextBox hc:TitleElement.Title="寄存器起始地址:"
                                 hc:TitleElement.TitleWidth="100"
                                 IsEnabled="{Binding MtcpSlave.IsRunning, Converter={wu:ReverseBool}}"
                                 Style="{StaticResource FormTextBox}"
                                 Text="{Binding MtcpSlave.HoldingStartAddress}" />

                        <TextBox hc:TitleElement.Title="寄存器数量:"
                                 hc:TitleElement.TitleWidth="100"
                                 IsEnabled="{Binding MtcpSlave.IsRunning, Converter={wu:ReverseBool}}"
                                 Style="{StaticResource FormTextBox}"
                                 Text="{Binding MtcpSlave.HoldingAddressCount}" />

                        <Button Margin="8,0"
                                Command="{Binding MtcpSlave.ApplyHoldingRangeCommand}"
                                Content="应用寄存器范围"
                                IsEnabled="{Binding MtcpSlave.IsRunning, Converter={wu:ReverseBool}}"
                                Style="{StaticResource BlueButton}" />

                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                            <Button Margin="20"
                                    Command="{Binding MtcpSlave.RunCommand}"
                                    Content="启动"
                                    IsEnabled="{Binding MtcpSlave.IsRunning, Converter={wu:ReverseBool}}"
                                    Style="{StaticResource GreenButton}" />

                            <Button Width="60"
                                    Margin="20"
                                    Command="{Binding MtcpSlave.StopCommand}"
                                    Content="停止"
                                    IsEnabled="{Binding MtcpSlave.IsRunning}"
                                    Style="{StaticResource RedButton}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </md:DrawerHost.LeftDrawerContent>

            <DockPanel>
                <Grid DockPanel.Dock="Top">
                    <TextBlock Style="{StaticResource TitleTextBlock}" Text="Modbus TCP 从站" />
                    <DockPanel LastChildFill="False">
                        <Button Width="30"
                                Height="{Binding RelativeSource={RelativeSource self}, Path=Width}"
                                Margin="5"
                                Command="{Binding ExecuteCommand}"
                                CommandParameter="OpenLeftDrawer"
                                Content="{md:PackIcon Kind=Cog}"
                                Style="{StaticResource Blue_CircleButton}" />

                        <Button Width="30"
                                Height="{Binding RelativeSource={RelativeSource self}, Path=Width}"
                                Margin="5"
                                Background="{StaticResource Green_Background}"
                                BorderBrush="{StaticResource Green_BorderBrush}"
                                Command="{Binding MtcpSlave.RunCommand}"
                                Content="{md:PackIcon Kind=Play}"
                                Foreground="{StaticResource Green_Foreground}"
                                IsEnabled="{Binding MtcpSlave.IsRunning, Converter={wu:ReverseBool}}"
                                Style="{StaticResource MaterialDesignFloatingActionMiniButton}" />

                        <Button Width="30"
                                Height="{Binding RelativeSource={RelativeSource self}, Path=Width}"
                                Margin="5"
                                Command="{Binding MtcpSlave.StopCommand}"
                                Content="{md:PackIcon Kind=Stop}"
                                IsEnabled="{Binding MtcpSlave.IsRunning}"
                                Style="{StaticResource Red_CircleButton}" />

                        <Button Width="30"
                                Height="{Binding RelativeSource={RelativeSource self}, Path=Width}"
                                Margin="5"
                                Command="{Binding MtcpSlave.MessageClearCommand}"
                                Content="{md:PackIcon Kind=Delete}"
                                Style="{StaticResource Red_CircleButton}" />
                    </DockPanel>
                </Grid>

                <TabControl Margin="4"
                            md:ColorZoneAssist.Background="{DynamicResource MaterialDesignCardBackground}"
                            md:ColorZoneAssist.Foreground="{DynamicResource PrimaryHueMidBrush}"
                            md:ColorZoneAssist.Mode="Custom"
                            Style="{StaticResource MaterialDesignFilledTabControl}">
                    <TabControl.Resources>
                        <Style BasedOn="{StaticResource MaterialDesignTabItem}" TargetType="TabItem">
                            <Setter Property="Height" Value="32" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                        </Style>
                    </TabControl.Resources>

                    <TabItem Header="保持寄存器">
                        <DataGrid Margin="4"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  ItemsSource="{Binding MtcpSlave.HoldingRegisters}"
                                  Style="{StaticResource NumDataGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding Address}"
                                                    Header="地址"
                                                    IsReadOnly="True" />
                                <DataGridTextColumn Binding="{Binding Address, StringFormat=0x{0:X4}}"
                                                    Header="地址Hex"
                                                    IsReadOnly="True" />
                                <DataGridTextColumn Binding="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="名称" />
                                <DataGridTextColumn Binding="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="值" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>

                    <TabItem Header="输入寄存器">
                        <DataGrid Margin="4"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  ItemsSource="{Binding MtcpSlave.InputRegisters}"
                                  Style="{StaticResource NumDataGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding Address}"
                                                    Header="地址"
                                                    IsReadOnly="True" />
                                <DataGridTextColumn Binding="{Binding Address, StringFormat=0x{0:X4}}"
                                                    Header="地址Hex"
                                                    IsReadOnly="True" />
                                <DataGridTextColumn Binding="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="名称" />
                                <DataGridTextColumn Binding="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="值" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>

                    <TabItem Header="线圈">
                        <DataGrid Margin="4"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  ItemsSource="{Binding MtcpSlave.Coils}"
                                  Style="{StaticResource NumDataGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding Address}"
                                                    Header="地址"
                                                    IsReadOnly="True" />
                                <DataGridTextColumn Binding="{Binding Address, StringFormat=0x{0:X4}}"
                                                    Header="地址Hex"
                                                    IsReadOnly="True" />
                                <DataGridTextColumn Binding="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="名称" />
                                <DataGridCheckBoxColumn Binding="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="值" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>

                    <TabItem Header="消息日志">
                        <ContentControl Margin="4" Style="{StaticResource Effect2Control}">
                            <hc:ScrollViewer wu:ScrollViewerExtensions.AlwaysScrollToEnd="True" IsInertiaEnabled="True">
                                <ItemsControl Background="Transparent" ItemsSource="{Binding MtcpSlave.Messages}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel VirtualizingPanel.CacheLength="2"
                                                                    VirtualizingPanel.CacheLengthUnit="Page"
                                                                    VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                                                                    VirtualizingPanel.VirtualizationMode="Recycling" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.Resources>
                                        <DataTemplate DataType="{x:Type core:MessageData}">
                                            <Border Style="{StaticResource MessageBorder}">
                                                <WrapPanel Orientation="Horizontal">
                                                    <TextBlock Margin="3"
                                                               VerticalAlignment="Center"
                                                               Style="{StaticResource MessageTextBlock}"
                                                               Text="{Binding Time, StringFormat={}{0:yyyy-MM-dd HH:mm:ss.fff}}" />
                                                    <TextBlock Margin="5,0"
                                                               VerticalAlignment="Center"
                                                               Style="{StaticResource MessageTextBlock}"
                                                               Text="{Binding Type}" />
                                                    <TextBox VerticalAlignment="Center"
                                                             FontSize="12"
                                                             FontWeight="Bold"
                                                             IsReadOnly="True"
                                                             Style="{StaticResource MessageTextBox}"
                                                             Text="{Binding Content}"
                                                             TextWrapping="Wrap" />
                                                </WrapPanel>
                                            </Border>
                                        </DataTemplate>

                                        <DataTemplate DataType="{x:Type models:MtcpMessageData}">
                                            <Border Style="{StaticResource MessageBorder}">
                                                <WrapPanel Orientation="Horizontal">
                                                    <TextBlock Margin="3"
                                                               VerticalAlignment="Center"
                                                               Style="{StaticResource MessageTextBlock}"
                                                               Text="{Binding Time, StringFormat={}{0:yyyy-MM-dd HH:mm:ss.fff}}" />
                                                    <TextBlock Margin="5,0"
                                                               VerticalAlignment="Center"
                                                               Style="{StaticResource MessageTextBlock}"
                                                               Text="{Binding Type}" />
                                                    <ItemsControl Background="Transparent" ItemsSource="{Binding MtcpSubMessageData}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel VerticalAlignment="Center" Orientation="Horizontal" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Margin="3,0,3,0"
                                                                           VerticalAlignment="Center"
                                                                           FontWeight="Bold"
                                                                           Style="{StaticResource MtcpMessageTextBlock}"
                                                                           Text="{Binding Content}" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </WrapPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.Resources>
                                </ItemsControl>
                            </hc:ScrollViewer>
                        </ContentControl>
                    </TabItem>
                </TabControl>
            </DockPanel>
        </md:DrawerHost>
    </Grid>
</UserControl>
